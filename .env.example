# ==========================================
# RepoGuard AI — Environment Configuration
# ==========================================

# Google Gemini AI Studio API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.8-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Backend Secret Key (Change for production)
SECRET_KEY=repoguard-secret-key-change-in-production

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./repoguard.db

# Storage Directory for Uploads and Extracted Archives
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
SCAN_TIMEOUT=300

# Scanner Binary Paths (Defaults look on system PATH)
# If installed in custom locations, provide absolute paths:
GITLEAKS_PATH=gitleaks
TRIVY_PATH=trivy
OSV_SCANNER_PATH=osv-scanner
SEMGREP_PATH=semgrep

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
